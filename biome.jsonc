{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": ["**", "!node_modules"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off",
        "useArrowFunction": "off"
      },
      "suspicious": {
        "noRedundantUseStrict": "off"
      }
    }
  }
}
